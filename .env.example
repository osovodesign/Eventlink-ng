# EventLink Environment Configuration (.env.example)
# Never commit real secrets or production credentials to this file.

# Application environment: "development" | "staging" | "production"
VITE_APP_ENV="production"

# Default launch currency and timezone
VITE_DEFAULT_CURRENCY="NGN"
VITE_DEFAULT_TIMEZONE="Africa/Lagos"

# Optional Firebase Web SDK overrides (for Vercel / external deployments)
# If omitted, the app uses the defaults in firebase-applet-config.json
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_DATABASE_ID=""

# Optional Gemini API Key (only needed if you add AI features later)
GEMINI_API_KEY=""
